---
interface Props {
  activePage?: string;
  brandPrimary?: string;
  brandSub?: string;
}

const {
  activePage = '',
  brandPrimary = 'Ranunkel e.V.',
  brandSub = 'Waldkindergarten Waldkirch',
} = Astro.props;

const links = [
  { href: '/traegerverein', label: 'Trägerverein' },
  { href: '/kindergarten', label: 'Kindergarten' },
  { href: '/spielgruppe', label: 'Spielgruppe' },
  { href: '/aktuelles', label: 'Aktuelles' },
  { href: '/faq', label: 'FAQ' },
];
---

<nav class="sitenav">
  <div class="nav-inner">
    <a class="nav-logo" href="/" aria-label={brandPrimary}>
      <img src="/logo.png" alt="" width="52" height="52" />
      <div>
        <div class="nav-logo-text-primary">{brandPrimary}</div>
        <div class="nav-logo-text-sub">{brandSub}</div>
      </div>
    </a>
    <div class="nav-links" id="navlinks">
      <a
        href="/"
        class={`nav-home${activePage === '/' ? ' nav-active' : ''}`}
        aria-label="Startseite"
        title="Startseite"
        aria-current={activePage === '/' ? 'page' : undefined}
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 10.5 12 3l9 7.5" />
          <path d="M5.5 9.5V20h13V9.5" />
          <path d="M9.75 20v-5.5h4.5V20" />
        </svg>
        <span class="nav-home-label">Startseite</span>
      </a>
      {links.map((link) => (
        <a href={link.href} class={activePage === link.href ? 'nav-active' : undefined}>
          {link.label}
        </a>
      ))}
      <a href="/anmeldung" class="nav-cta">Anmeldung</a>
    </div>
    <button class="nav-hamburger" id="hamburger" aria-label="Menü öffnen">
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>
