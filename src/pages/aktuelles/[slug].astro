---
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../../keystatic.config';
import BaseLayout from '../../layouts/BaseLayout.astro';
import RichText from '../../components/RichText';
import ClickableImage from '../../components/ClickableImage';
import { buildPostSlugs } from '../../utils/slug';
import { markdocToPlainText } from '../../utils/plainText';
import { renderBody } from '../../utils/markdoc';

export async function getStaticPaths() {
  const reader = createReader(process.cwd(), keystaticConfig);
  const page = await reader.singletons.aktuelles.read();
  const items = page?.items ?? [];
  const slugs = buildPostSlugs([...items]);

  return Promise.all(
    items.map(async (item, index) => {
      // Transform Markdoc here already: the reader returns Ast.Node instances
      // whose methods do not survive being passed between routes as props.
      const body = item.body ? await item.body() : null;
      return {
        params: { slug: slugs[index] },
        props: {
          highlight: item.highlight,
          date: item.date,
          title: item.title,
          image: item.image,
          teaser: item.teaser,
          content: body ? renderBody(body.node) : null,
          plainText: markdocToPlainText(body?.node),
        },
      };
    })
  );
}

const { highlight, date, title, image, teaser, content, plainText } = Astro.props;
// Meta description: prefer the teaser, fall back to the start of the body.
const description = (teaser || plainText).slice(0, 160);
---

<BaseLayout
  title={`${title} — Aktuelles — Ranunkel e.V.`}
  description={description}
  activePage="/aktuelles"
>
  <div class="page-content">
    <a class="btn-link article-back" href="/aktuelles">← Zurück zu Aktuelles</a>

    <article class="article article--detail">
      {image && (
        <ClickableImage src={image} alt={title} className="article-img" client:visible />
      )}
      <div class="article-body">
        <div class="article-meta">
          {highlight && (
            <span class="article-tag article-tag--highlight">Highlight</span>
          )}
          {date && <span class="article-date">{date}</span>}
        </div>
        <h1>{title}</h1>
        {content && <RichText content={content} />}
      </div>
    </article>
  </div>
</BaseLayout>
